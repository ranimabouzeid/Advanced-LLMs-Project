# Copy to .env and replace placeholders only when configuring a live client.
# Load explicitly with load_settings(env_file=".env") or Uvicorn --env-file .env.
GROQ_MODEL=replace-with-verified-model-id
GROQ_API_KEY=replace-with-your-api-key
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Comma-separated local frontend origins; API defaults to localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173
