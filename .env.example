# ==============================================================================
# SWARMDOCK Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual keys.
# Never commit your .env file to version control.
# ==============================================================================

# --- Option A: Google Gemini Configuration (Default in backend/app/config.py) ---
LLM_PROVIDER=google_genai
# Recommended Gemini models: gemini-3.8-flash, gemini-3.7-flash
LLM_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=replace-with-your-google-api-key
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Option B: Groq Cloud Configuration (Fast inference & high daily limits) ---
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=replace-with-your-groq-api-key
# Active Groq models:
# - qwen/qwen3.8-27b      (Recommended: Ultra-fast 0.28s, native JSON output)
# - groq/compound-mini    (Balanced tool-use / reasoning model)
# - openai/gpt-oss-120b   (Large open-weights reasoning model)
GROQ_MODEL=qwen/qwen3.8-27b

# --- Backend & CORS Settings ---
# Comma-separated local frontend origins; API defaults to localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:5173
